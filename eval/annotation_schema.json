{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "J.A.R.V.I.S. Ranking Evaluation Item",
  "description": "Schema for the future real-world manually annotated ranking corpus.",
  "type": "object",
  "required": ["id", "title", "summary", "area", "source", "published", "expected_relevance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "area": {"type": "string", "enum": ["TECH", "AI/ML", "FINANCE", "SCIENCE", "WORLD", "POLITICS", "OTHER"]},
    "source": {"type": "string", "minLength": 1},
    "published": {"type": "string", "format": "date-time"},
    "url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": "string", "format": "uri"},
    "duplicate_group": {"type": ["string", "null"]},
    "split": {"type": "string", "enum": ["dev", "test"]},
    "expected_relevance": {"type": "integer", "minimum": 0, "maximum": 100},
    "annotation_version": {"type": "string", "minLength": 1},
    "annotator_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "annotated_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
